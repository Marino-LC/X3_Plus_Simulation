<?xml version="1.0"?>

<robot name="Omni_bot" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:include filename="$(find omni_description)/urdf/mecanum_wheel.xacro"/>

    <link name="base_footprint"/>

    <link name="base_link">

        <inertial>
            <origin xyz="0.00498197982182523 5.70233829969297E-05 -0.0121008098068578" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia
                    ixx="0.196277727666921"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.457256033711368"
                    iyz="0.0"
                    izz="0.493927269870476"/>
        </inertial>

        <visual>
            <origin xyz="${base_link_xyz}" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${base_mesh}"/>
            </geometry>
            <material name="">
                <color rgba="0 0.7 0 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="${base_link_xyz}" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${base_mesh}"/>
            </geometry>
        </collision>

    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0815" rpy="0 0 0"/>
    </joint>

<!-- Ruedas mecanum.
        X: FL y BR llevan la misma quiralidad (derecha), FR y BL la otra (izquierda).
        Las posiciones/orientaciones son las mismas que usaba la rueda anterior. -->
    <xacro:mecanum_wheel_derecha   prefix="front_left"  parent="base_link" xyz="${f_l_wheel_xyz}" rpy="1.5703 0 0"/>
    <xacro:mecanum_wheel_izquierda prefix="front_right" parent="base_link" xyz="${f_r_wheel_xyz}" rpy="-1.5703 0 3.14159"/>
    <xacro:mecanum_wheel_derecha   prefix="back_right"  parent="base_link" xyz="${b_r_wheel_xyz}" rpy="-1.57 0 3.14159"/>
    <xacro:mecanum_wheel_izquierda prefix="back_left"   parent="base_link" xyz="${b_l_wheel_xyz}" rpy="1.5703 0 0"/>
    
</robot>