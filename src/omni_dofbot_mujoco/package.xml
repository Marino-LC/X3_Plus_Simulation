<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omni_dofbot_mujoco</name>
  <version>0.1.0</version>
  <description>Simulación MuJoCo del X3 Plus + Dofbot (rodillos mecanum con junta libre) y puente ROS 2 para correr el AG sin modificarlo.</description>
  <maintainer email="todo@todo.todo">Marino-LC</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>omni_dofbot_bringup</exec_depend>
  <!-- MuJoCo se instala con pip: python3 -m pip install mujoco -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
