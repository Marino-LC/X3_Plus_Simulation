<?xml version="1.0" encoding="utf-8"?>
<!--Aqui comienza el robot-->
<robot name="robot_scara" xmlns:xacro="http://ros.org/wiki/xacro" >

  <link name="camera_link">
      <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0"/>
          <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
      <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
              <mesh filename="file://$(find omni_description)/meshes/sensor/visual/camera_link.STL"/>
          </geometry>
          <material name="">
              <color rgba="0.7 0.7 0.7 1"/>
          </material>
      </visual>
      <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
              <mesh filename="file://$(find omni_description)/meshes/sensor/visual/camera_link.STL"/>
          </geometry>
      </collision>
  </link>

  <joint name="camera_joint" type="fixed">
      <origin xyz="${camera_joint_xyz}" rpy="${camera_joint_rpy}"/>
      <parent link="base_link"/>
      <child link="camera_link"/>
  </joint>

  <link name="camera_PC_link">
  </link>
  <joint name="camera_PC_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="-1.57 0 -1.57"/>
      <parent link="camera_link"/>
      <child link="camera_PC_link"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="rgbd_camera" name="camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <topic>camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.085595</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
 

</robot>