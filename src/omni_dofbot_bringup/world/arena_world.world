<?xml version="1.0" ?>
<!--
  arena_world.world — v3 (experimento de navegación, Artículo 1)
  Cinco obstáculos de 0.25 m de alto, sin pedestal ni objetos a manipular.
  Este archivo es la fuente de verdad de la geometría: maps/generate_map.py
  genera el mapa de referencia a partir de él, y config/goals.yaml define
  el spawn y las 5 goal poses.
-->
<sdf version="1.7">
  <world name="arena_world">

  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/> 
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- Necesario para los sensores de contacto de paredes/obstáculos (detección de colisiones) -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.4</sor>
        </solver>
      </ode>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>
    <light name="ambient_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Suelo melamina mu=0.4 -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.7 2.7 0.02</size></box></geometry>
          <pose>0 0 -0.01 0 0 0</pose>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu><mu2>0.45</mu2>
                <fdir1>1 0 0</fdir1>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp><kd>100</kd>
                <min_depth>0.001</min_depth>
                <max_vel>1.0</max_vel>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.7 2.7 0.02</size></box></geometry>
          <pose>0 0 -0.01 0 0 0</pose>
          <material>
            <ambient>0.92 0.87 0.78 1</ambient>
            <diffuse>0.92 0.87 0.78 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Paredes perimetrales -->
    <model name="wall_north">
      <static>true</static><pose>0 1.35 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.7 0.03 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.7 0.03 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>c</collision><topic>/contacts/wall_north</topic></contact>
        </sensor>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -1.35 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.7 0.03 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.7 0.03 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>c</collision><topic>/contacts/wall_south</topic></contact>
        </sensor>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>1.35 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.03 2.7 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.03 2.7 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>c</collision><topic>/contacts/wall_east</topic></contact>
        </sensor>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-1.35 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.03 2.7 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.03 2.7 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>c</collision><topic>/contacts/wall_west</topic></contact>
        </sensor>
      </link>
    </model>

    <!-- ═══ Obstáculos: altura 0.25 m, por encima del haz del LiDAR (~0.19 m) para que
         AMCL, los costmaps y SLAM los detecten. maps/generate_map.py los lee de aquí. ═══ -->
    <!-- O1 — caja 0.30 × 0.30 m en (-0.60, -0.20) -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>-0.60 -0.20 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>collision</collision><topic>/contacts/obstacle_1</topic></contact>
        </sensor>
      </link>
    </model>

    <!-- O2 — caja 0.20 × 0.20 m en (0.55, -0.35) -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>0.55 -0.35 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.25</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.25</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>collision</collision><topic>/contacts/obstacle_2</topic></contact>
        </sensor>
      </link>
    </model>

    <!-- O3 — muro 0.70 × 0.10 m en (0.00, 0.35) -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>0.00 0.35 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.1 0.25</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.1 0.25</size></box></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.8 0.5 0.1 1</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>collision</collision><topic>/contacts/obstacle_3</topic></contact>
        </sensor>
      </link>
    </model>

    <!-- O4 — cilindro r = 0.12 m en (-0.85, 0.80) -->
    <model name="obstacle_4">
      <static>true</static>
      <pose>-0.85 0.80 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>collision</collision><topic>/contacts/obstacle_4</topic></contact>
        </sensor>
      </link>
    </model>

    <!-- O5 — caja 0.25 × 0.25 m en (0.80, 0.80) -->
    <model name="obstacle_5">
      <static>true</static>
      <pose>0.80 0.80 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.25 0.25</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.25 0.25</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>collision</collision><topic>/contacts/obstacle_5</topic></contact>
        </sensor>
      </link>
    </model>

    <!-- Marcadores visuales (sin colisión, bajo el haz del LiDAR): spawn en azul, goals en verde -->
    <model name="marker_spawn"><static>true</static><pose>0.00 -0.91 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0 0.4 1 0.7</ambient><diffuse>0 0.4 1 0.7</diffuse></material></visual></link></model>
    <model name="marker_goal_1"><static>true</static><pose>-1.00 -0.90 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0 0.8 0.2 0.7</ambient><diffuse>0 0.8 0.2 0.7</diffuse></material></visual></link></model>
    <model name="marker_goal_2"><static>true</static><pose>0.95 -0.85 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0 0.8 0.2 0.7</ambient><diffuse>0 0.8 0.2 0.7</diffuse></material></visual></link></model>
    <model name="marker_goal_3"><static>true</static><pose>0.00 0.85 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0 0.8 0.2 0.7</ambient><diffuse>0 0.8 0.2 0.7</diffuse></material></visual></link></model>
    <model name="marker_goal_4"><static>true</static><pose>-1.00 0.25 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0 0.8 0.2 0.7</ambient><diffuse>0 0.8 0.2 0.7</diffuse></material></visual></link></model>
    <model name="marker_goal_5"><static>true</static><pose>0.95 0.20 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0 0.8 0.2 0.7</ambient><diffuse>0 0.8 0.2 0.7</diffuse></material></visual></link></model>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -3.5 4.5 0 0.75 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
